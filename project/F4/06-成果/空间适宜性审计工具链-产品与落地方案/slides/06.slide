            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 10, height: 10, background: '#1E4FA8' }} />
                <Text style={{ fontSize: 20, color: '#1A2230' }}>共同需求：这个结论我能用到多细、多稳</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 10, height: 10, background: '#D9534F' }} />
                <Text style={{ fontSize: 20, color: '#1A2230' }}>边界：以下都是目标对象，不是客户名单</Text>
