            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 10, height: 10, background: '#1E4FA8' }} />
                <Text style={{ fontSize: 20, color: '#1A2230' }}>问题二：网格粗于池体时，精度还成立吗</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 10, height: 10, background: '#1E4FA8' }} />
                <Text style={{ fontSize: 20, color: '#1A2230' }}>问题三：报告少写一项，后果有多大</Text>
            </Box>
        </Box>
