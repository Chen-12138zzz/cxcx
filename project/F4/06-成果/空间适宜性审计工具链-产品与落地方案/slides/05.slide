<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>

    <Box style={{ width: 1280, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#BFD5EF', letterSpacing: 2 }}>01 这是什么产品</Text>
        <Text style={{ fontSize: 14, color: '#BFD5EF' }}>空间适宜性审计工具链</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 24, flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E4FA8' }}>产品形态：一个可被独立复现的工具链</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>不追求"更大"，追求"每个数字都能被第三方重跑出来"</Text>
    </Box>

    {/* 形态声明条 */}
    <Box style={{ marginLeft: 40, marginRight: 40, marginTop: 20, height: 150, background: '#F0F5FC', borderLeft: '6px solid #1E4FA8', padding: 20, flexDirection: 'column', gap: 10, justifyContent: 'center' }}>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.35 }}>
            只依赖 numpy · 无网络请求 · 可完全离线运行
        </Text>
        <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
            秩相关、AHP 特征向量、块平均全部用显式线性代数重实现，不调 GIS 库 ——
            因为现成库把每一步封装成黑箱，无法在"权重变化 0.01 时排序变了几个"这一粒度上测量。
        </Text>
    </Box>

    {/* 四个度量卡 */}
    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 20, height: 210, flexDirection: 'row', gap: 18 }}>

        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>3,010</Text>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>代码行</Text>
            <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.4 }}>15 个文件</Text>
        </Box>

        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>25</Text>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>公开接口</Text>
            <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.4 }}>4 个模块</Text>
        </Box>

        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>140+31</Text>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>断言与判据</Text>
            <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.4 }}>140 与 31</Text>
        </Box>

        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderTop: '4px solid #FFC107', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>5 / 5</Text>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>门禁全通过</Text>
            <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.4 }}>退出码 0</Text>
        </Box>

    </Box>

    {/* 交付物（单条横向清单，避免四卡各自换行） */}
    <Box style={{ marginLeft: 40, marginRight: 40, marginTop: 18, height: 108, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 14, flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>交付什么</Text>
        <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.4 }}>
            审计报告（含 14 条局限）　·　修正记录 26 条　·　原始结果 JSON 4 份　·　一键复现入口
        </Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>全部【合成】真值已知；接口 4 模块均由脚本抽取核对；同种子逐位可复现</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>05 / 14</Text>
    </Box>

</Slide>
