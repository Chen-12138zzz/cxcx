<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>

    <Box style={{ width: 1280, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#BFD5EF', letterSpacing: 2 }}>01 这是什么产品</Text>
        <Text style={{ fontSize: 14, color: '#BFD5EF' }}>水产 AI 可信性工程</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 20, flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E4FA8' }}>产品做哪三件事</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>第三件事是产品性格，不是可选项 —— 一个只会输出的审计器没有意义</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 16, height: 520, flexDirection: 'row', gap: 22 }}>

        {/* 左：三件事 */}
        <Box style={{ width: 700, flexDirection: 'column', gap: 10 }}>

            <Box style={{ height: 156, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 14, flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 36, height: 36, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>逐数字证据审计</Text>
                    <Box style={{ paddingLeft: 12, paddingRight: 12, height: 26, background: '#E8EFF8', borderRadius: 13, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>已实现</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    把一段预警文本里的<span style={{ fontWeight: 'bold', color: '#1A2230' }}>每一个数字</span>回溯到数据源，
                    判定它有没有被支持。
                </Text>
            </Box>

            <Box style={{ height: 156, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 14, flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 36, height: 36, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>忠实度度量</Text>
                    <Box style={{ paddingLeft: 12, paddingRight: 12, height: 26, background: '#E8EFF8', borderRadius: 13, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>已实现</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    区分「结论<span style={{ fontWeight: 'bold', color: '#1A2230' }}>被来源支持</span>」与
                    「结论只是<span style={{ fontWeight: 'bold', color: '#D9534F' }}>措辞像被支持</span>」。
                </Text>
            </Box>

            <Box style={{ height: 156, background: '#FBE9E8', border: '1px solid #D9534F', padding: 14, flexDirection: 'column', gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 36, height: 36, background: '#D9534F', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>拒答与回退</Text>
                    <Box style={{ paddingLeft: 12, paddingRight: 12, height: 26, background: '#FFFFFF', borderRadius: 13, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 14, color: '#D9534F' }}>产品性格</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    证据不足时<span style={{ fontWeight: 'bold', color: '#D9534F' }}>不输出</span>，
                    而不是编一个像样的结论。
                </Text>
            </Box>

        </Box>

        {/* 右：审计链路 SVG + 交付物 */}
        <Box style={{ width: 478, flexDirection: 'column', gap: 18 }}>

            <Box style={{ height: 254, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', marginBottom: 4 }}>审计链路</Text>
                <svg width={442} height={196} viewBox='0 0 442 196'>
                    <rect x='0' y='4' width='442' height='42' rx='4' fill='#F0F5FC' stroke='#D6DCE5' strokeWidth='1' />
                    <text x='14' y='22' fontSize='13' fill='#8B97A8'>输入</text>
                    <text x='14' y='39' fontSize='14' fill='#1A2230'>预警文本：「溶氧降至 2.8，建议立即增氧」</text>

                    <line x1='221' y1='50' x2='221' y2='70' stroke='#3D7BD9' strokeWidth='2' />
                    <polygon points='221,72 216,62 226,62' fill='#3D7BD9' />

                    <rect x='0' y='76' width='442' height='42' rx='4' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1' />
                    <text x='14' y='94' fontSize='13' fill='#1E4FA8'>逐数字回溯</text>
                    <text x='14' y='111' fontSize='14' fill='#1A2230'>2.8 → 传感器 A 记录 2.81　｜　阈值 → 规则表 v3</text>

                    <line x1='221' y1='122' x2='221' y2='142' stroke='#3D7BD9' strokeWidth='2' />
                    <polygon points='221,144 216,134 226,134' fill='#3D7BD9' />

                    <rect x='0' y='148' width='442' height='42' rx='4' fill='#FFFFFF' stroke='#D6DCE5' strokeWidth='1' />
                    <text x='14' y='166' fontSize='13' fill='#8B97A8'>判定</text>
                    <text x='14' y='183' fontSize='14' fill='#1A2230'>支持　/　不支持　/　无法判定（此档拒答）</text>
                </svg>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>交付什么</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    ① 逐条审计报告<br />
                    ② 识别假设台账（A1–A6）<br />
                    ③ 判定口径文档（可复现）
                </Text>
            </Box>

        </Box>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>三件事都来自上一轮项目遗留、已在本地实现并跑通的可评测资产（非概念稿）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>04 / 14</Text>
    </Box>

</Slide>
