            }}
            cells={[
                [
                    { text: '问题表现', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '为什么会发生', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '我们怎么处理', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '怎么验证有没有用', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                ],
                [
                    { text: '数字对不上源', textStyle: { bold: true } },
