                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 5, flex: 1 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>这是什么产品</Text>
