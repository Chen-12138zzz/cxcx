        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 22, paddingLeft: 18, paddingRight: 18, paddingTop: 14, paddingBottom: 14, background: '#F0F5FC', borderRadius: 6, border: '1px solid #D6DCE5' }}>
            <Box style={{ width: 52, height: 52, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 5, flex: 1 }}>
