        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 22, paddingLeft: 18, paddingRight: 18, paddingTop: 14, paddingBottom: 14, background: '#FFFFFF', borderRadius: 6, border: '1px solid #D6DCE5' }}>
            <Box style={{ width: 52, height: 52, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 5, flex: 1 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>服务谁</Text>
                <Text style={{ fontSize: 16, color: '#4A5568' }}>四层对象 · 三个真实触发场景 · 谁最痛</Text>
