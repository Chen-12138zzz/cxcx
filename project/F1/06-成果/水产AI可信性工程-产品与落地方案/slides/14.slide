            </Box>

            <Box style={{ height: 118, background: '#FBE9E8', border: '1px solid #D9534F', padding: 14, flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#D9534F' }}>我们的选择：不绕过</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.35 }}>
