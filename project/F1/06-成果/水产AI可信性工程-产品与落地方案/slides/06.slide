<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>

    <Box style={{ width: 1280, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#BFD5EF', letterSpacing: 2 }}>02 服务谁</Text>
        <Text style={{ fontSize: 14, color: '#BFD5EF' }}>水产 AI 可信性工程</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 20, flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E4FA8' }}>四层对象，四类需求</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>以下是目标对象，不是客户名单 —— 目前一家也没有</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 16, height: 520, flexDirection: 'column', gap: 14 }}>

        <Box style={{ flexDirection: 'row', gap: 14, height: 230 }}>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>养殖户 / 合作社</Text>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    收到预警后想知道：
                    <br />「这条的数字从哪来？」
                    <br />「错了找谁？」
                </Text>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>技术服务商 / 设备商</Text>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    自己产出的预警要经得起客户追问，
                    <br />否则售后成本全压在
                    <br />「解释为什么报了」上。
                </Text>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>高校 / 科研团队</Text>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    用观测数据推出效应结论，
                    <br />投稿时会被审稿人反复问
                    <br />识别假设。
                </Text>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>04</Text>
                    </Box>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>保险 / 金融风控</Text>
                </Box>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    定损或授信引用了
                    <br />养殖监测结论，需要它
                    <br />能被追溯到数据。
                </Text>
            </Box>

        </Box>

        <Box style={{ flexDirection: 'row', gap: 14, height: 184 }}>

            <Box style={{ width: 700, background: '#E8EFF8', borderLeft: '4px solid #1E4FA8', padding: 16, flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>优先级：从第 03 类切入</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    其一，科研团队已经在被迫回答识别假设的问题，需求最现成；
                    其二，我们缺的评审方就在这一层，切进去等于同时解决需求与阻断项。
                </Text>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 19, color: '#4A5568' }}>第 01、02 类怎么触达</Text>
                <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.4 }}>
                    不直接做 C 端 —— 经服务商与合作社
                    <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>间接嵌入</span>他们的交付物。
                </Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>对象分类为在本项目场景下的自定划分，非引自文献或市场调研；未做任何真实客户访谈</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>06 / 14</Text>
    </Box>

</Slide>
