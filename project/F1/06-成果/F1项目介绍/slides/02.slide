                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>问题与边界</Text>
                <Text style={{ fontSize: 16, color: '#4A5568' }}>三个问题 · 数据里的三个陷阱 · 和同类工作差在哪</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 24, padding: 20, background: '#FFFFFF', borderRadius: 6, border: '1px solid #D6DCE5' }}>
            <Box style={{ width: 56, height: 56, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>方法设计</Text>
