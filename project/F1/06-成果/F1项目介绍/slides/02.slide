        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 24, padding: 20, background: '#F0F5FC', borderRadius: 6, border: '1px solid #D6DCE5' }}>
            <Box style={{ width: 56, height: 56, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
