<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>

    <Box style={{ width: 1280, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#BFD5EF', letterSpacing: 2 }}>03 实验与结论</Text>
        <Text style={{ fontSize: 14, color: '#BFD5EF' }}>F1 · 项目介绍</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 20, flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E4FA8' }}>21/21 通过，以及它背后的修正史</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>报通过数必须连同修正史一起报，否则就是误导</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 16, height: 520, flexDirection: 'row', gap: 20 }}>

        {/* 左：KPI + 判定分布 */}
        <Box style={{ width: 360, flexDirection: 'column', gap: 12 }}>

            <Box style={{ height: 158, background: '#0E3F8C', padding: 20, flexDirection: 'column', justifyContent: 'center', gap: 4 }}>
                <Text style={{ fontSize: 16, color: '#8FB4E0' }}>判定项通过率</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 8 }}>
                    <Text style={{ fontSize: 84, fontWeight: 'bold', color: '#FFC107', lineHeight: 0.95 }}>21</Text>
                    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#6E9BD1', lineHeight: 1.3 }}>/21</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#BFD5EF' }}>另有不变量测试 19/19 通过</Text>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>各实验判定</Text>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>估计器无偏性</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>3 / 3</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>正性诊断边界</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>4 / 4</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>坏控制代价</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>3 / 3</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>剂量-反应</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>4 / 4</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>敏感性分析</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>5 / 5</Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 17, color: '#4A5568' }}>测试套件</Text>
                    <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>2 / 2</Text>
                </Box>
            </Box>

            <Box style={{ height: 78, background: '#E8EFF8', borderLeft: '4px solid #D9534F', padding: 14, flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.45 }}>
                    碰撞的破坏力约为中介的 <b style={{ color: '#D9534F' }}>4.5 倍</b>
                    <br /><span style={{ fontSize: 14, color: '#8B97A8' }}>区间 4.02–5.12【合成】</span>
                </Text>
            </Box>

        </Box>

        {/* 右：修正史表格 */}
        <Box style={{ width: 816, flexDirection: 'column', gap: 12 }}>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, height: 40 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>18 条修正记录</Text>
                <Box style={{ paddingLeft: 12, paddingRight: 12, height: 28, background: '#FBE9E8', borderRadius: 14, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#D9534F' }}>含 5 条判据设计错误</Text>
                </Box>
            </Box>

            <Table
                style={{ width: '100%', height: 250 }}
                defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#D6DCE5' },
                        right: { width: 1, color: '#D6DCE5' },
                        top: { width: 1, color: '#D6DCE5' },
                        bottom: { width: 1, color: '#D6DCE5' },
                    },
                }}
                cells={[
                    [
                        { text: '归类', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '条数', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '典型例子', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    ],
                    [
                        { text: '判据设计错误', textStyle: { bold: true, color: '#D9534F' } },
                        { text: '5', textStyle: { bold: true, color: '#D9534F' } },
                        '诊断模块的「结构性空箱」判定，经检验在原理上不可用',
                    ],
                    [
                        { text: '实现缺陷', cellStyle: { background: { color: '#F7F9FC' } }, textStyle: { bold: true, color: '#1A2230' } },
                        { text: '6', cellStyle: { background: { color: '#F7F9FC' } }, textStyle: { color: '#1A2230' } },
                        { text: '真值未换算到结果尺度，造成全体估计器常数偏倚', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    [
                        { text: '参数语义 / 下游症状 / 判据过严', textStyle: { bold: true } },
                        { text: '3' },
                        '干预参数只平移分布、不截断支撑，无法制造声称的违背',
                    ],
                    [
                        { text: '文档类', cellStyle: { background: { color: '#F7F9FC' } }, textStyle: { bold: true, color: '#1A2230' } },
                        { text: '4', cellStyle: { background: { color: '#F7F9FC' } }, textStyle: { color: '#1A2230' } },
                        { text: '路径写错、状态滞后一轮、覆盖缺口披露不完整（收尾阶段发现）', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                ]}
            />

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>为什么这些数字必须留着</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.45 }}>
                    含信息的是那些<b>曾经失败的原始数字</b>。正性诊断第一版在
                    <b style={{ color: '#D9534F' }}>无任何真实违背</b>时，20 个种子<b>全部</b>报阳性 —— 假阳性率 100%。
                    这个「20/20」比「全部通过」有价值得多。
                </Text>
            </Box>

        </Box>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>全部数值为【合成】数据实测，见 05-验证/results_exp*.json，不得外推真实塘口</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>09 / 12</Text>
    </Box>

</Slide>
